<?xml version="1.0"?>
<ruleset name="php-compatibility">
    <description>
        Cross-version PHP compatibility gate for the shipped library.
        Code style is owned by PHP-CS-Fixer.
    </description>

    <file>src</file>

    <!-- Composer requires ^8.1: PHP 8.1 and later 8.x minors, excluding PHP 9. -->
    <config name="testVersion" value="8.1-8.99"/>

    <rule ref="PHPCompatibility"/>
</ruleset>
